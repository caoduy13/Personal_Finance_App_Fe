# Dev: để trống → request tương đối từ origin (localhost) → Vite proxy tới BE (xem vite.config.ts).
VITE_API_URL=

# Rollback nhanh khi BE down — ép toàn bộ service về mock (requestStrategy).
VITE_FORCE_MOCK=false

# (tuỳ chọn) Điền sẵn form đăng nhập khi mở /login
VITE_DEV_PREFILL_LOGIN_EMAIL=
VITE_DEV_PREFILL_LOGIN_PASSWORD=
