# API host root (KHÔNG có /api/v1 ở cuối)
VITE_API_URL=https://personal-finance-management-api.onrender.com

# Set "true" để buộc toàn bộ request về mock (rollback nhanh khi BE down)
VITE_FORCE_MOCK=false

# "true" → auth (/api/v1/auth/*), /User/me (PATCH hồ sơ), POST /Onboarding và GET /api/v1/categories dùng BE thật
# (không áp khi VITE_FORCE_MOCK=true). "false" → mock trong app (anh@finjar.app, …).
VITE_USE_REAL_AUTH=false

# (tuỳ chọn dev) Điền sẵn form đăng nhập khi mở /login — VD user vừa tạo qua script e2e-test-user.mjs
VITE_DEV_PREFILL_LOGIN_EMAIL=
VITE_DEV_PREFILL_LOGIN_PASSWORD=
